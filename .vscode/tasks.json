{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "flutter-analyze",
			"type": "shell",
			"command": "flutter",
			"args": [
				"analyze"
			],
			"problemMatcher": [
				"$dart"
			],
			"group": "build"
		},
		{
			"label": "flutter-build-apk-release",
			"type": "shell",
			"command": "flutter",
			"args": [
				"build",
				"apk",
				"--release"
			],
			"problemMatcher": [
				"$dart"
			],
			"group": "build"
		}
	]
}