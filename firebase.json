{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": "links_hosting",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/invite/**",
        "destination": "/invite/index.html"
      },
      {
        "source": "/invite",
        "destination": "/invite/index.html"
      },
      {
        "source": "/invite-accepted",
        "destination": "/invite-accepted.html"
      },
      {
        "source": "/privacy/**",
        "destination": "/privacy/index.html"
      },
      {
        "source": "/privacy",
        "destination": "/privacy/index.html"
      }
    ]
  }
}
