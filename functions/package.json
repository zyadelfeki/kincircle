{
  "name": "kincircle-functions",
  "description": "Firebase Cloud Functions for KinCircle",
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "lint": "eslint . --ext .ts",
    "clean": "rimraf lib",
    "deploy": "npm run build && firebase deploy --only functions",
    "test": "echo \"No unit tests yet\"",
    "backfill:feedback": "node scripts/backfill_bigquery.js --dataset firestore_export --table alert_feedback_labeled --file scripts/sample_alert_feedback.jsonl"
  },
  "dependencies": {
    "@google-cloud/bigquery": "^7.1.0",
    "@google-cloud/vertexai": "^1.10.0",
    "@sendgrid/mail": "^8.1.0",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^4.2.0",
    "kincircle": "file:.."
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "rimraf": "^5.0.5",
    "typescript": "^5.4.0"
  }
}
