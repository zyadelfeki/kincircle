<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ splash: use windowBackground only, no Theme.SplashScreen dependency needed -->
    <style name="LaunchTheme" parent="@style/Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/splashBackground</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
